# Speculative Decoding Accelerator -- Environment Variables
# Copy to .env and adjust as needed.

# Set to "true" for demo mode (no real model endpoints required)
DEMO_MODE=false

# Target (larger) model -- used for baseline and verification
TARGET_MODEL_URL=http://ollama:11434/v1
TARGET_MODEL_NAME=qwen2.5:1.5b

# Draft (smaller) model -- proposes tokens for speculative decoding
DRAFT_MODEL_URL=http://ollama:11434/v1
DRAFT_MODEL_NAME=qwen2.5:0.5b

# Optional: vLLM native speculative decoding endpoint
SPECULATIVE_MODEL_URL=

# Optional: API key if model endpoints require authentication
MODEL_API_KEY=

# Speedup must exceed this threshold to be labelled "faster"
SPECULATIVE_CLAIM_THRESHOLD=1.5

# Number of tokens the draft model proposes per step
NUM_SPECULATIVE_TOKENS=5
